# Grow in Jesus Choir - Financial Monitoring Platform
# Environment Configuration Template

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Grow in Jesus Choir Financial Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Public site origin used in invitation links and branded email logos/actions.
# Production must use HTTPS. NEXT_PUBLIC_APP_URL is used when APP_URL is empty.
APP_URL=
NEXT_PUBLIC_DEFAULT_CURRENCY="RWF"
APP_TIME_ZONE=Africa/Kigali

# PostgreSQL / Supabase Database
# Use Supabase transaction-pooler port 6543 for app runtime. Vercel limits its local pool
# to one client and converts Supabase pooler port 5432 URLs to transaction mode.
POSTGRES_DATABASE_URL=
# Optional path to the Supabase database root CA certificate for verified TLS.
POSTGRES_CA_CERT_PATH=certs/supabase-ca.crt
# Optional direct connection URI for migrations or tools that require a direct connection.
POSTGRES_DIRECT_URL=
# Legacy-compatible alias; if set, this must also be a PostgreSQL URI.
DATABASE_URL=

# Authentication uses users/password_hash and revocable sessions in PostgreSQL.
# Set this only if you need a custom cookie name. Production defaults to a __Host- cookie.
AUTH_SESSION_COOKIE_NAME=

# Centralized Brevo delivery. Outbox email stays queued until these are configured.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Grow in Jesus Choir"
# Required to authorize scheduled processing at POST /api/internal/brevo-outbox.
CRON_SECRET=

# Private Supabase Storage (documents only; Supabase Auth is not used)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

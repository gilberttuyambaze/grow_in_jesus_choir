# Grow in Jesus Choir - Financial Monitoring Platform
# Environment Configuration Template

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Grow in Jesus Choir Financial Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="RWF"

# Database Configuration
DATABASE_URL="./data/choir_finance.db"

# Session & Authentication Security
AUTH_SECRET="change-this-to-a-secure-random-32-byte-hex-secret-in-production"
AUTH_SESSION_COOKIE_NAME="gijc_session"

# File Storage (Receipts & Financial Documents)
# For local development, uploads are preserved in ./data/uploads (outside public root)
SECURE_STORAGE_PATH="./data/uploads"
MAX_UPLOAD_SIZE_BYTES=5242880

